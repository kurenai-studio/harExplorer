{
  "name": "har-explore",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "HAR game asset extractor — CLI + web viewer for Cocos 2.x/3.x / Pragmatic / Slotmill / GameArt",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "har-lab": "node packages/cli/src/har-lab.mjs",
    "build:catalog": "node packages/cli/src/build-texture-viewer-catalog.mjs",
    "build:catalog:enrich": "node packages/cli/src/build-texture-viewer-catalog.mjs --enrich",
    "enrich:atlas-frames": "node scripts/enrich-catalog-atlas-frames.mjs",
    "hydrate:cdn": "node scripts/hydrate-cdn-cache.mjs",
    "build": "node packages/cli/src/build-texture-viewer.mjs",
    "serve": "node packages/web/server.mjs",
    "minigame": "node tools/minigame/analyze-wechat.mjs",
    "spine": "node packages/cli/src/extract-cocos-spine-packs.mjs",
    "font": "node packages/cli/src/extract-bitmap-font.mjs",
    "particle": "node packages/cli/src/extract-har-particles.mjs",
    "audio": "node packages/cli/src/extract-har-audio.mjs",
    "bake": "node packages/cli/src/spine-to-frames.mjs",
    "spine-player": "node packages/cli/src/serve-spine-player.mjs",
    "pack": "node scripts/pack-portable-win.mjs",
    "pack:full": "node scripts/pack-portable-win.mjs --with-bake"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "texture2ddecoder-wasm": "^1.2.5"
  }
}
